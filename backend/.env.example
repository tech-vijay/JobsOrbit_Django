# Django Security & Debug
DJANGO_SECRET_KEY=django-insecure-jobsorbit-super-secret-key-2026-change-in-prod
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated or * for all)
ALLOWED_HOSTS=*

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (Optional)
# Leave empty for local SQLite (db.sqlite3).
# Paste your Supabase / PostgreSQL URI to connect to Cloud Database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Cloudinary Configuration (Optional - fallback to local media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
